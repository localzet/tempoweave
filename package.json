{
  "name": "tempoweave",
  "version": "1.0.1",
  "description": "Offline-first desktop control center for Kimai, Jira, NPD receipts, rates, payouts, taxes and workload analytics.",
  "main": "src/main/index.js",
  "type": "commonjs",
  "author": "localzet",
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.mjs",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "43.8.1",
    "electron-builder": "26.15.7"
  },
  "build": {
    "appId": "dev.localzet.tempoweave",
    "productName": "TempoWeave",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE",
      "README.md"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/localzet/tempoweave.git"
  },
  "homepage": "https://github.com/localzet/tempoweave#readme",
  "bugs": {
    "url": "https://github.com/localzet/tempoweave/issues"
  },
  "keywords": [
    "kimai",
    "jira",
    "time-tracking",
    "offline-first",
    "electron",
    "npd",
    "freelance",
    "finance",
    "sqlite"
  ]
}
